#!/usr/bin/env python3
# Gera um gráfico de linguagens por tamanho usando a API GraphQL do GitHub.
# Requer: requests, matplotlib
import os, sys, requests, collections
import matplotlib.pyplot as plt

# Parâmetros
login = os.getenv("TARGET_USER", "") or (sys.argv[1] if len(sys.argv) > 1 else "Miguel54075")
token = os.getenv("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")
if not token:
    print("Erro: variável GITHUB_TOKEN não definida.")
    sys.exit(1)

headers = {"Authorization": f"bearer {token}"}
query = """
query ($login: String!, $cursor: String) {
  repositoryOwner(login: $login) {
    repositories(first: 100, after: $cursor) {
      nodes {
        name
        isFork
        languages(first: 100) {
          edges {
            size
            node {
              name
            }
          }
        }
      }
      pageInfo {
        hasNextPage
        endCursor
      }
    }
  }
}
"""

totals = collections.Counter()
has_next = True
cursor = None
repo_count = 0

while has_next:
    variables = {"login": login, "cursor": cursor}
    resp = requests.post("https://api.github.com/graphql", json={"query": query, "variables": variables}, headers=headers)
    resp.raise_for_status()
    data = resp.json()
    if "errors" in data:
        print("Erros GraphQL:", data["errors"])
        sys.exit(1)
    repo_conn = data["data"]["repositoryOwner"]["repositories"]
    nodes = repo_conn.get("nodes") or []
    for node in nodes:
        # opcional: pular forks
        if node.get("isFork"):
            continue
        repo_count += 1
        langs = (node.get("languages") or {}).get("edges") or []
        for edge in langs:
            name = edge["node"]["name"]
            size = edge["size"] or 0
            totals[name] += size
    page_info = repo_conn["pageInfo"]
    has_next = page_info["hasNextPage"]
    cursor = page_info["endCursor"]

if not totals:
    print("Nenhuma linguagem encontrada.")
    sys.exit(0)

# Preparar dados para gráfico
langs, sizes = zip(*totals.most_common())
total = sum(sizes)

# Criar pasta images se não existir
out_dir = "images"
os.makedirs(out_dir, exist_ok=True)
out_path = os.path.join(out_dir, "langs.png")

# Gráfico pizza (resumido)
plt.figure(figsize=(8,8))
# mostrar apenas as top 8, agrupar o resto como "Other"
top_n = 8
if len(langs) > top_n:
    top_langs = list(langs[:top_n]) + ["Other"]
    top_sizes = list(sizes[:top_n]) + [sum(sizes[top_n:])]
else:
    top_langs = langs
    top_sizes = sizes

colors = plt.get_cmap("tab20").colors
plt.pie(top_sizes, labels=[f"{l} ({s})" for l,s in zip(top_langs, top_sizes)], autopct=lambda p: f"{p:.1f}%")
plt.title(f"Linguagens de {login} — total {total} bytes (agregado)")
plt.tight_layout()
plt.savefig(out_path, dpi=150)
plt.close()

print(f"Gráfico gerado em: {out_path} (repositórios processados: {repo_count})")
